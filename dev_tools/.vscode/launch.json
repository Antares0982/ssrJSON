{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debug: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "python": "${workspaceFolder}/.nix-devenv/bin/python",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/build"
            }
        },
        {
            "name": "(gdb) Launch clang",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/.nix-devenv-llvm/debugLLVM/bin/llc",
            "args": [
                "-O3",
                "ssrjson.ll"
            ],
            "sourceFileMap": {
                "/build": "${workspaceFolder}/debug_source"
            },
            "stopAtEntry": true,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "enable gdb pretty printing",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "set disassembly flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                }
            ],
            "miDebuggerArgs": "-x ${workspaceFolder}/dev_tools/.gdbinit",
        },
        {
            "name": "(gdb) Launch",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/.nix-devenv/bin/python",
            "args": [
                "${file}"
            ],
            "sourceFileMap": {
                "/build": "${workspaceFolder}/debug_source"
            },
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [
                {
                    "name": "PYTHONPATH",
                    "value": "${workspaceFolder}/build"
                }
            ],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "enable gdb pretty printing",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "set disassembly flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                }
            ],
            "miDebuggerArgs": "-x ${workspaceFolder}/dev_tools/.gdbinit",
            "preLaunchTask": "CMake: build with last config"
        },
        {
            "name": "(gdb) Launch python",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/.nix-devenv/bin/python",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [
                {
                    "name": "PYTHONPATH",
                    "value": "${workspaceFolder}/build"
                }
            ],
            "sourceFileMap": {
                "/build": "${workspaceFolder}/debug_source"
            },
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "enable gdb pretty printing",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "set disassembly flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "CMake: build with last config"
        },
        {
            "name": "(gdb) Launch pytest",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/.nix-devenv/bin/python",
            "args": [
                "-m",
                "pytest",
                "-s",
                "-rxX",
                "./python-test"
            ],
            "environment": [
                {
                    "name": "PYTHONPATH",
                    "value": "${workspaceFolder}/build"
                }
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "sourceFileMap": {
                "/build": "${workspaceFolder}/debug_source"
            },
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "enable gdb pretty printing",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "set disassembly flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "CMake: build with last config"
        },
        {
            "name": "(gdb) Launch pytest (current file)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/.nix-devenv/bin/python",
            "args": [
                "-m",
                "pytest",
                "-s",
                "-rxX",
                "${file}"
            ],
            "environment": [
                {
                    "name": "PYTHONPATH",
                    "value": "${workspaceFolder}/build"
                }
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "sourceFileMap": {
                "/build": "${workspaceFolder}/debug_source"
            },
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "enable gdb pretty printing",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "set disassembly flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "CMake: build with last config"
        },
        {
            "name": "(gdb) Launch pytest python315",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/.nix-devenv/bin/python3.15",
            "args": [
                "-m",
                "pytest",
                "-s",
                "-rxX",
                "./python-test"
            ],
            "environment": [
                {
                    "name": "PYTHONPATH",
                    "value": "${workspaceFolder}/build-py3.15"
                }
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "sourceFileMap": {
                "/build": "${workspaceFolder}/debug_source"
            },
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "enable gdb pretty printing",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "set disassembly flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "(gdb) Launch decode fuzzer",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build-fuzz/ssrjson_decode_fuzzer",
            "args": [
                "-dict=${workspaceFolder}/test_data/fuzzer/fuzzer.dict",
                "-max_total_time=300",
                "${workspaceFolder}/build-fuzz/decode_corpus"
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/build-fuzz",
            "environment": [
                {
                    "name": "PYTHONPATH",
                    "value": "${workspaceFolder}/test_data/fuzzer"
                }
            ],
            "sourceFileMap": {
                "/build": "${workspaceFolder}/debug_source"
            },
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "enable gdb pretty printing",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "set disassembly flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "CMake: build fuzz (ASAN + fuzzer)"
        },
        {
            "name": "(gdb) Launch encode fuzzer",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build-fuzz/ssrjson_encode_fuzzer",
            "args": [
                "-dict=${workspaceFolder}/test_data/fuzzer/encode_fuzzer.dict",
                "-max_total_time=300",
                "${workspaceFolder}/build-fuzz/encode_corpus"
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/build-fuzz",
            "environment": [
                {
                    "name": "PYTHONPATH",
                    "value": "${workspaceFolder}/test_data/fuzzer"
                }
            ],
            "sourceFileMap": {
                "/build": "${workspaceFolder}/debug_source"
            },
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "enable gdb pretty printing",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "set disassembly flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "CMake: build fuzz (ASAN + fuzzer)"
        },
        {
            "name": "(gdb) Launch C test",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/ssrjson_test",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/build",
            "environment": [],
            "sourceFileMap": {
                "/build": "${workspaceFolder}/debug_source"
            },
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "enable gdb pretty printing",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "set disassembly flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "CMake: build with last config"
        }
    ]
}